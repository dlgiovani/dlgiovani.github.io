---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LangThemeBar from '../interactive/LangThemeBar.astro';
import BlogBar from './BlogBar.astro';
import SidePanel from './SidePanel.astro';
import RelatedPosts from './RelatedPosts.astro';
import BackToTop from './BackToTop.astro';
import { useTranslations } from '../../i18n/ui';
import {
  blogHref,
  formatDate,
  postAltHrefs,
  postLocale,
  readingMinutes,
  relatedPosts,
  type Post,
} from '../../lib/blog';
import '../../styles/blog.css';

interface Props { entry: Post }
const { entry } = Astro.props;

const locale = postLocale(entry);
const t = useTranslations(locale);
const { Content, headings } = await render(entry);
const alt = await postAltHrefs(entry);
const related = await relatedPosts(entry, 3);
const minutes = readingMinutes(entry.body ?? '');
const isoDate = entry.data.date.toISOString().slice(0, 10);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  ogImage={entry.data.cover}
  altEn={alt.en}
  altPt={alt.pt}
  mirrored={alt.mirrored}
>
  <div class="blog">
    <BlogBar locale={locale} showProgress />

    <div class="blog-shell">
      <header class="blog-head">
        <p class="blog-kicker">
          {(entry.data.tags ?? []).length > 0 ? entry.data.tags![0] : t('blog.title')}
        </p>
        <h1 class="blog-title">{entry.data.title}</h1>
        <p class="blog-standfirst">{entry.data.description}</p>

        <div class="blog-meta">
          <time datetime={isoDate}>{formatDate(entry.data.date, locale)}</time>
          <span class="dot" aria-hidden="true">·</span>
          <span>{minutes} {t('blog.min_read')}</span>
          {(entry.data.tags ?? []).length > 0 && (
            <>
              <span class="dot" aria-hidden="true">·</span>
              <span class="blog-tags">
                {entry.data.tags!.map((tag) => <span class="blog-tag">{tag}</span>)}
              </span>
            </>
          )}
        </div>

        {entry.data.cover && (
          <figure class="blog-cover">
            <img
              src={entry.data.cover}
              alt=""
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
            />
            {entry.data.image_credit?.text && (
              <figcaption>
                {entry.data.image_credit.url
                  ? <a href={entry.data.image_credit.url} target="_blank" rel="noopener noreferrer">{entry.data.image_credit.text}</a>
                  : entry.data.image_credit.text}
              </figcaption>
            )}
          </figure>
        )}
      </header>

      <SidePanel locale={locale} headings={headings} />

      <article class="blog-article">
        <div class="blog-prose">
          <Content />
        </div>
      </article>

      <footer class="blog-foot">
        <RelatedPosts locale={locale} posts={related} />

        <nav class="blog-endnav" aria-label={t('blog.nav_label')}>
          <a href={blogHref(locale)}>← {t('blog.all_posts')}</a>
          <a href="#top" data-to-top>{t('blog.to_top')} ↑</a>
        </nav>
      </footer>
    </div>

    <BackToTop locale={locale} />
  </div>

  <LangThemeBar locale={locale} enHref={alt.en} ptHref={alt.pt} />
</Base>

<script is:inline>
  // Drop cap goes on the first real paragraph, skipping short notices and the
  // `<middots>` dividers some posts open with. Runs during parse, before paint.
  (function () {
    var prose = document.querySelector('.blog-prose');
    if (!prose) return;
    var paragraphs = Array.prototype.filter.call(prose.children, function (el) {
      return el.tagName === 'P';
    });
    var target = paragraphs.find(function (p) {
      if (p.querySelector('middots, img')) return false;
      if (p.children.length === 1 && p.children[0].tagName === 'STRONG') return false;
      return (p.textContent || '').trim().length >= 80;
    }) || paragraphs[0];
    if (target) target.classList.add('dropcap');
  })();

  // External links in post bodies open in a new tab.
  document.querySelectorAll('.blog-prose a[href^="http"]').forEach(function (a) {
    if (a.host !== location.host) {
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
    }
  });

  document.querySelectorAll('[data-to-top]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  });
</script>
